{
	"extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
	"include": [
		"electron.vite.config.ts",
		"src/electron/main/**/*.ts",
		"src/electron/preload/**/*.ts",
		"src/shared/**/*.ts"
	],
	"exclude": [
		"src/**/*.svelte",
		"src/routes/**/*",
		"vite.config.ts",
		"src/**/*.spec.ts",
		"src/**/*.test.ts"
	],
	"compilerOptions": {
		"types": ["electron-vite/node"],
		"noEmit": true
	}
}
